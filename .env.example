# Nextcloud / Supabase OIDC (valori non segreti)
SUPABASE_OAUTH_NEXTCLOUD_CLIENT_ID=d99c5b72-1881-43b0-ba58-4256d3c1437d
NEXTCLOUD_OIDC_LOGIN_URL=https://nx101824.your-storageshare.de/apps/user_oidc/login/3

# Le altre variabili applicative vanno configurate nell'ambiente di deploy.
# Il Client Secret OIDC non appartiene al CRM: resta solo in Supabase/Nextcloud.

# Meta Lead Ads webhook diretto
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Opzionale: per gestire piu' Pagine dalla stessa route.
# Esempio: {"1234567890":"EAAB...","9876543210":"EAAB..."}
META_PAGE_ACCESS_TOKENS_JSON=
META_GRAPH_API_VERSION=v21.0
# Opzionale: Pagina evidenziata come "Attiva" in Impostazioni > Integrazioni >
# Meta Ads. Default: 113871998412187 (SolairGroup).
META_ACTIVE_PAGE_ID=
# Opzionale ma consigliato: abilita verifica X-Hub-Signature-256.
META_APP_SECRET=

# Roberta knowledge ingestion (CRM)
ANTHROPIC_API_KEY=
ROBERTA_INGEST_MODEL=claude-sonnet-5

# Archivio ufficiale del modulo Offerta Commerciale (Team Folder Nextcloud)
OFFERTA_COMMERCIALE_NEXTCLOUD_PATH=Solair/Offerta-Commerciale

# API key di /api/public/calculate-quote (Authorization: Bearer).
# Dedicata: non riusare LISTINO_READ_KEY, cosi' le due si ruotano separatamente.
# Senza questa variabile l'endpoint risponde 503.
CALCULATE_QUOTE_KEY=
# Origin ammessi dagli endpoint pubblici (calculate-quote, discount-code).
# Default se vuota: https://solairgroup.it, https://www.solairgroup.it
PUBLIC_DISCOUNT_ALLOWED_ORIGINS=

# Server MCP remoto (custom connector Claude) — app/api/mcp
# Bearer statico che Claude presenta a ogni richiesta: genera con
# `openssl rand -base64 32`. Senza questa variabile la rotta risponde 503.
MCP_ACCESS_TOKEN=
# Utente Supabase impersonato dal bearer statico qui sopra: e' l'auth.users.id
# (non utenti.id). Il service_role serve solo a coniare il suo JWT, mai a
# leggere o scrivere dati business. Con OAuth attivo questa coppia resta solo
# come percorso di compatibilita' per il connettore gia' configurato.
VITO_USER_ID=
# Chiave con cui si firmano gli access token OAuth del connettore MCP
# (`openssl rand -base64 48`). E' l'unico segreto che rende multi-utente il
# server: senza, /authorize e /token rispondono che il connettore non e'
# configurato e resta valido solo il bearer statico.
MCP_OAUTH_SIGNING_KEY=
# Solo se l'origine pubblica non e' deducibile dalle intestazioni inoltrate
# (proxy anomali): fissa issuer e endpoint annunciati nei metadata OAuth.
# Esempio: https://crm.solairgroup.it
MCP_OAUTH_ISSUER=
