From 64030064cff6a60e41b0af73cc2828ccef4fca82 Mon Sep 17 00:00:00 2001
From: Claude <claude@mostagstudio.local>
Date: Thu, 27 Aug 2026 15:30:17 +0000
Subject: [PATCH 1/2] fix: rimuove scrollbar orizzontale duplicata in
 leads/clienti/installatori/scadenze/compiti
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Il contenitore principale scrollabile aveva overflow-auto (nativo su
entrambi gli assi) invece di overflow-x-hidden, mentre esisteva già una
barra orizzontale dedicata sincronizzata in basso (pensata per il
mobile). Risultato: due scrollbar orizzontali sovrapposte.

Ora l'overflow-x nativo del contenitore principale è disattivato: resta
un'unica barra orizzontale, quella dedicata in basso, che pilota lo
scroll via scrollLeft programmatico (compatibile con overflow-x:hidden).
Interessa data-table-shell.tsx (clienti/installatori/scadenze/compiti)
e lead-table.tsx (leads, implementazione standalone).
---
 components/leads/lead-table.tsx    | 2 +-
 components/ui/data-table-shell.tsx | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/components/leads/lead-table.tsx b/components/leads/lead-table.tsx
index c1300d7..b0fd8e2 100644
--- a/components/leads/lead-table.tsx
+++ b/components/leads/lead-table.tsx
@@ -778,7 +778,7 @@ export function LeadTable({
           const delta = shiftedWheel ? e.deltaY : e.deltaX
           el.scrollLeft += delta * 0.72
         }}
-        className="min-h-0 flex-1 overscroll-contain overflow-auto bg-card outline-none [scroll-behavior:auto] [touch-action:pan-x_pan-y] [-webkit-overflow-scrolling:touch] focus-visible:ring-2 focus-visible:ring-ring/40 [scrollbar-color:var(--crm-scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-[var(--crm-scrollbar-thumb)] [&::-webkit-scrollbar-track]:bg-muted/40 [&::-webkit-scrollbar]:h-2.5 [&::-webkit-scrollbar]:w-2.5"
+        className="min-h-0 flex-1 overscroll-contain overflow-y-auto overflow-x-hidden bg-card outline-none [scroll-behavior:auto] [touch-action:pan-x_pan-y] [-webkit-overflow-scrolling:touch] focus-visible:ring-2 focus-visible:ring-ring/40 [scrollbar-color:var(--crm-scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-[var(--crm-scrollbar-thumb)] [&::-webkit-scrollbar-track]:bg-muted/40 [&::-webkit-scrollbar]:w-2.5"
       >
         {/* table semplice (no wrapper shadcn): un solo contenitore di scroll,
             così l'header sticky e la barra orizzontale dedicata funzionano. */}
diff --git a/components/ui/data-table-shell.tsx b/components/ui/data-table-shell.tsx
index 994bf42..e745cab 100644
--- a/components/ui/data-table-shell.tsx
+++ b/components/ui/data-table-shell.tsx
@@ -10,7 +10,7 @@ import {
 import { cn } from "@/lib/utils"
 
 const SCROLLER_CLASS =
-  "min-h-0 flex-1 overscroll-contain overflow-auto bg-card outline-none [scroll-behavior:auto] [touch-action:pan-x_pan-y] [-webkit-overflow-scrolling:touch] focus-visible:ring-2 focus-visible:ring-ring/40 [scrollbar-color:var(--crm-scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-[var(--crm-scrollbar-thumb)] [&::-webkit-scrollbar-track]:bg-muted/40 [&::-webkit-scrollbar]:h-2.5 [&::-webkit-scrollbar]:w-2.5"
+  "min-h-0 flex-1 overscroll-contain overflow-y-auto overflow-x-hidden bg-card outline-none [scroll-behavior:auto] [touch-action:pan-x_pan-y] [-webkit-overflow-scrolling:touch] focus-visible:ring-2 focus-visible:ring-ring/40 [scrollbar-color:var(--crm-scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-[var(--crm-scrollbar-thumb)] [&::-webkit-scrollbar-track]:bg-muted/40 [&::-webkit-scrollbar]:w-2.5"
 
 const H_SCROLL_CLASS =
   "shrink-0 overscroll-contain overflow-x-auto overflow-y-hidden border-t border-border bg-card [scroll-behavior:auto] [scrollbar-color:var(--crm-scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-[var(--crm-scrollbar-thumb)] [&::-webkit-scrollbar-track]:bg-muted/40 [&::-webkit-scrollbar]:h-2.5"
