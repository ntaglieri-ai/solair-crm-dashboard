+      if (typeof value !== "string") return fail()
+      try {
+        const url = new URL(value)
+        if (url.protocol !== "http:" && url.protocol !== "https:") return fail()
+      } catch {
+        return fail()
+      }
+      return value
     case "boolean":
       if (typeof value !== "boolean") return fail()
       return value
